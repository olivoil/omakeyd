#!/usr/bin/env python3
"""Root-owned runtime helper for one constrained Omakeyd operation.

The caller may replace only the thirty primary-key values inside an existing
Omakeyd-managed keyd layer. It cannot choose a path, add keyd actions, run a
command, or alter any other section of a keyd profile.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
from collections import Counter
from pathlib import Path


KEYD_DIR = Path("/etc/keyd")
RUNTIME_DIR = Path("/run/omakeyd")
PROFILE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$")
MANAGED_BEGIN = "# >>> OMAKEYD MANAGED LAYOUT >>>"
MANAGED_END = "# <<< OMAKEYD MANAGED LAYOUT <<<"
ROWS = (
    ("q", "w", "e", "r", "t", "y", "u", "i", "o", "p"),
    ("a", "s", "d", "f", "g", "h", "j", "k", "l", "semicolon"),
    ("z", "x", "c", "v", "b", "n", "m", "comma", "dot", "slash"),
)
KEYS = tuple(key for row in ROWS for key in row)
KEY_SET = frozenset(KEYS)


class HelperError(RuntimeError):
    pass


def emit(payload: dict[str, object], status: int = 0) -> int:
    print(json.dumps(payload, separators=(",", ":")))
    return status


def fail(message: str, detail: str = "") -> int:
    error: dict[str, str] = {"code": "helper-failed", "message": message}
    if detail:
        error["detail"] = detail
    return emit({"ok": False, "error": error}, 1)


def managed_layer(profile: str) -> str:
    safe = re.sub(r"[^a-z0-9_]", "_", profile.lower().replace("-", "_"))
    return f"omakeyd_{safe}"[:63]


def acquire_lock() -> int:
    RUNTIME_DIR.mkdir(mode=0o700, exist_ok=True)
    metadata = RUNTIME_DIR.lstat()
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0:
        raise HelperError("The Omakeyd runtime directory is unsafe.")
    os.chmod(RUNTIME_DIR, 0o700)
    descriptor = os.open(
        RUNTIME_DIR / "keyd-profile.lock",
        os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW,
        0o600,
    )
    fcntl.flock(descriptor, fcntl.LOCK_EX)
    return descriptor


def parse_rows(value: str) -> list[str]:
    keys = [key.strip().lower() for key in value.split(",")]
    counts = Counter(keys)
    if len(keys) != 30 or set(keys) != KEY_SET or any(count != 1 for count in counts.values()):
        raise HelperError("The requested layout is not a complete primary-key permutation.")
    return keys


def checked_profile(profile: str) -> tuple[Path, os.stat_result, str, str]:
    if not PROFILE_RE.fullmatch(profile):
        raise HelperError("Invalid keyd profile identifier.")
    path = KEYD_DIR / f"{profile}.conf"
    try:
        metadata = path.lstat()
    except OSError as error:
        raise HelperError(f"Cannot inspect {path}: {error}") from error
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise HelperError("The keyd profile must be a regular, non-symlink file.")
    if metadata.st_uid != 0 or metadata.st_mode & 0o022:
        raise HelperError("The keyd profile must be root-owned and not writable by group or others.")
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as error:
        raise HelperError(f"Cannot read {path}: {error}") from error
    layer = managed_layer(profile)
    if text.count(MANAGED_BEGIN) != 1 or text.count(MANAGED_END) != 1:
        raise HelperError("The profile does not contain exactly one Omakeyd-managed layer.")
    global_match = re.search(r"(?ms)^\s*\[global]\s*$\n(.*?)(?=^\s*\[|\Z)", text)
    if not global_match or not re.search(
        rf"(?m)^\s*default_layout\s*=\s*{re.escape(layer)}\s*(?:#.*)?$",
        global_match.group(1),
    ):
        raise HelperError("The Omakeyd-managed layer is not this profile's default layout.")
    marker_start = text.index(MANAGED_BEGIN)
    marker_end = text.index(MANAGED_END)
    if marker_end <= marker_start:
        raise HelperError("The managed-layer markers are malformed.")
    body = text[marker_start:marker_end]
    if not re.search(rf"(?m)^\s*\[{re.escape(layer)}:layout]\s*$", body):
        raise HelperError("The managed block does not contain the expected keyd layout.")
    return path, metadata, text, layer


def managed_block(layer: str, keys: list[str]) -> str:
    lines = [MANAGED_BEGIN, f"[{layer}:layout]"]
    for source, target in zip(KEYS, keys):
        lines.append(f"{source} = {target}")
    lines.append(MANAGED_END)
    return "\n".join(lines)


def replaced_text(text: str, layer: str, keys: list[str]) -> str:
    pattern = re.compile(
        rf"(?ms)^{re.escape(MANAGED_BEGIN)}\s*$.*?^{re.escape(MANAGED_END)}\s*$"
    )
    updated, count = pattern.subn(managed_block(layer, keys), text)
    if count != 1:
        raise HelperError("The managed keyd block could not be replaced safely.")
    return updated if updated.endswith("\n") else updated + "\n"


def stage(path: Path, metadata: os.stat_result, text: str) -> Path:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.omakeyd-", suffix=".tmp", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, stat.S_IMODE(metadata.st_mode))
        os.fchown(descriptor, metadata.st_uid, metadata.st_gid)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            descriptor = -1
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        return temporary
    except Exception:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)
        raise


def keyd(command: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            ["/usr/bin/keyd", *command],
            check=False,
            capture_output=True,
            text=True,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise HelperError(f"Could not run keyd: {error}") from error


def systemctl(command: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            ["/usr/bin/systemctl", *command, "keyd.service"],
            check=False,
            capture_output=True,
            text=True,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise HelperError(f"Could not control the keyd service: {error}") from error


def service_active() -> bool:
    return systemctl(["is-active", "--quiet"]).returncode == 0


def restart_keyd(stability_seconds: float = 5.0) -> None:
    result = systemctl(["restart"])
    if result.returncode != 0:
        raise HelperError(
            result.stderr.strip()
            or result.stdout.strip()
            or "The keyd service did not restart."
        )

    deadline = time.monotonic() + stability_seconds
    while time.monotonic() < deadline:
        if not service_active():
            raise HelperError("The keyd service stopped after restarting.")
        time.sleep(0.25)
    if not service_active():
        raise HelperError("The keyd service stopped after restarting.")


def apply(profile: str, rows: str) -> dict[str, object]:
    requested = parse_rows(rows)
    path, metadata, original, layer = checked_profile(profile)
    updated = replaced_text(original, layer, requested)
    temporary = stage(path, metadata, updated)
    try:
        check = keyd(["check", str(temporary)])
        if check.returncode != 0:
            raise HelperError(check.stderr.strip() or check.stdout.strip() or "keyd rejected the staged profile.")
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
        try:
            restart_keyd()
        except HelperError as activation_error:
            rollback = stage(path, metadata, original)
            os.replace(rollback, path)
            try:
                restart_keyd()
            except HelperError as rollback_error:
                raise HelperError(
                    f"{activation_error} The previous profile was restored on disk, "
                    f"but keyd could not be restarted: {rollback_error}"
                ) from activation_error
            raise HelperError(
                f"{activation_error} The previous profile was restored and keyd was restarted."
            ) from activation_error
    finally:
        temporary.unlink(missing_ok=True)
    return {"ok": True, "profile": profile, "managedLayer": layer}


def main() -> int:
    parser = argparse.ArgumentParser(prog="omakeyd-helper")
    subparsers = parser.add_subparsers(dest="command", required=True)
    apply_parser = subparsers.add_parser("apply")
    apply_parser.add_argument("--profile", required=True)
    apply_parser.add_argument("--rows", required=True)
    args = parser.parse_args()
    if os.geteuid() != 0:
        return fail("The Omakeyd helper must run through pkexec.")
    lock_descriptor = -1
    try:
        lock_descriptor = acquire_lock()
        if args.command == "apply":
            return emit(apply(args.profile, args.rows))
        raise HelperError("Unsupported helper operation.")
    except HelperError as error:
        return fail("The requested keyd layout was not applied.", str(error))
    except Exception as error:
        return fail("The requested keyd layout was not applied.", str(error))
    finally:
        if lock_descriptor >= 0:
            os.close(lock_descriptor)


if __name__ == "__main__":
    sys.exit(main())
